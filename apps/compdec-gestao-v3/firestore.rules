rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function role() { return verified() ? request.auth.token.role : null; }
    function nupdecClaim() { return verified() ? request.auth.token.nupdecId : null; }
    function isManager() { return role() in ['SUPER_ADMIN','GESTOR_COMPDEC','COORDENADOR']; }
    function isStock() { return isManager() || role() == 'ALMOXARIFADO'; }
    function isLeader() { return role() == 'LIDER_NUPDEC'; }
    function sameNupdec(id) { return isLeader() && nupdecClaim() == id; }

    match /{document=**} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if verified() && (request.auth.uid == uid || isManager());
      allow write: if false;
    }
    match /nupdecs/{id} {
      allow read: if verified() && (isManager() || isStock() || role() == 'CONSULTA' || sameNupdec(id));
      allow write: if false;
    }
    match /teams/{id} {
      allow read: if verified() && (isManager() || isStock() || role() == 'CONSULTA');
      allow write: if false;
    }
    match /volunteers/{id} {
      allow read: if verified() && (isManager() || (isLeader() && resource.data.nupdecId == nupdecClaim()));
      allow write: if false;
    }
    match /volunteerPrivate/{id} {
      allow read: if isManager();
      allow write: if false;
    }
    match /inventoryItems/{id} {
      allow read: if isStock() || isLeader();
      allow write: if false;
    }
    match /stockLocations/{id} {
      allow read: if isStock() || (isLeader() && resource.data.nupdecId == nupdecClaim());
      allow write: if false;
    }
    match /stockBalances/{id} {
      allow read: if isStock();
      allow write: if false;
    }
    match /stockMovements/{id} {
      allow read: if isStock();
      allow write: if false;
    }
    match /custodies/{id} {
      allow read: if verified() && (isStock() || (isLeader() && resource.data.nupdecId == nupdecClaim()));
      allow write: if false;
    }
    match /materialRequests/{id} {
      allow read: if verified() && (isStock() || (isLeader() && resource.data.nupdecId == nupdecClaim()));
      allow write: if false;
    }
    match /trainings/{id} {
      allow read: if verified() && (isManager() || role() == 'CONSULTA' || (isLeader() && resource.data.nupdecId == nupdecClaim()));
      allow write: if false;
    }
    match /meetings/{id} {
      allow read: if verified() && (isManager() || role() == 'CONSULTA' || (isLeader() && resource.data.nupdecId == nupdecClaim()));
      allow write: if false;
    }
    match /alerts/{id} {
      allow read: if verified();
      allow write: if false;
    }
    match /attendance/{id} {
      allow read: if verified() && (isManager() || (isLeader() && resource.data.nupdecId == nupdecClaim()));
      allow write: if false;
    }
    match /documents/{id} {
      allow read: if verified() && (isManager() || (isLeader() && resource.data.nupdecId == nupdecClaim()));
      allow write: if false;
    }
    match /readinessSnapshots/{id} {
      allow read: if verified();
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if isManager();
      allow write: if false;
    }
    match /systemSettings/{id} {
      allow read: if isManager();
      allow write: if false;
    }
  }
}
